          "text": "Деточка, настоящий Курт сегодня уехал на север, а у обочины стоит кто-то в его куртке! Дай мне согреться моей обычной выпечкой."
        }
      ],
      "choices": [
        {
          "text": "Подать тёплый вишнёвый пирог",
          "requireHeldItem": "cherry_pie",
          "forbidFlag": "n2_valya_served",
          "actions": [
            {
              "type": "clear_item",
              "target": ""
            },
            {
              "type": "set_flag",
              "target": "n2_valya_served"
            },
            {
              "type": "play_sfx",
              "target": "audio/sfx/sfx_cash_register.wav"
            }
