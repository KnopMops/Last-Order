      "choices": [
        {
          "text": "[04:00] Завершить Ночь 3 и перейти к Ночи 4",
          "nextNode": "n3_ending_complete",
          "requireFlag": "n3_shift_0400_ready"
        },
        {
          "text": "Начать смену",
          "nextNode": "",
          "forbidFlag": "n3_shift_0400_ready",
          "actions": [
