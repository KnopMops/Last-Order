      "choices": [
        {
          "text": "[04:00] Открыть двери кафе навстречу рассвету (ФИНАЛ)",
          "nextNode": "n5_ending_true",
          "requireFlag": "n5_boss_banished"
        },
        {
          "text": "Принять финальную смену",
