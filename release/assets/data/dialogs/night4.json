    {
      "id": "n4_intro_diary",
      "lines": [
        {
          "speaker": "Ночь 4 — «Полночный звонок»",
          "text": "«Кафе в осаде теней. Ответь на звонок Веры, обслужи Офицера Бориса, зачищай зал в 3D-шутере „ОКО-86“ [V] (клавиша [X] вызывает подкрепление фантомов) и выжги 5 зеркальных двойников у Музыкального автомата»."
        }
      ],
      "choices": [
        {
          "text": "[04:00] Закрыть кассу и перейти к финальной Ночи 5",
          "nextNode": "n4_ending_complete",
          "requireFlag": "n4_shift_0400_ready"
        },
        {
          "text": "Начать смену",
          "nextNode": "",
          "forbidFlag": "n4_shift_0400_ready",
          "actions": [
            {
              "type": "set_flag",
              "target": "n4_read_diary"
            }
          ]
        }
      ]
    },
    {
      "id": "n4_phone_ring_talk",
      "lines": [
        {
          "speaker": "Телефон на стене",
          "text": "Сквозь треск помех слышен голос Веры: «Лера, они лезут сквозь зеркало в левом коридоре! Подойди к зеркалу и выжги пятерых двойников лучом фонарика!»"
        }
