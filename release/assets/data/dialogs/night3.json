        }
      ],
      "choices": [
        {
          "text": "[3D Мини-игра] Войти в морозильный лабиринт за уликами 1986 года",
          "forbidFlag": "n3_fridge_checked",
          "actions": [
            {
              "type": "event",
              "target": "start_minigame_n3"
            }
          ],
          "nextNode": ""
        },
        {
          "text": "Отойти",
          "nextNode": ""
        }
      ]
    },
